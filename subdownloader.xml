<?xml version="1.0"?>
<Container version="2">
  <Name>Subtitel downloader</Name>
  <Repository>local-subdownloader:v7</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <Overview>Custom webapp voor OpenSubtitles downloads.</Overview>
  <Category>MediaApp:Other</Category>
  <WebUI>http://[IP]:[PORT:5000]</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/png/opensubtitles.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="5000" Default="5000" Mode="tcp" Description="Web interface poort" Type="Port" Display="always" Required="true" Mask="false">5000</Config>
  <Config Name="Media Map" Target="/media" Default="/mnt/user/media" Mode="rw" Description="Selecteer je hoofdmap" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media</Config>
  <Config Name="OpenSubtitles 3x API Keys" Target="OS_API_KEYS" Default="" Mode="" Description="API keys" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="OpenSubtitles Username" Target="OS_USERNAME" Default="" Mode="" Description="Je inlognaam" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="OpenSubtitles Password" Target="OS_PASSWORD" Default="" Mode="" Description="Je wachtwoord" Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="Discord Webhook URL" Target="DISCORD_WEBHOOK" Default="" Mode="" Description="Plak hier je Discord Webhook URL voor notificaties (optioneel)" Type="Variable" Display="always" Required="false" Mask="true"></Config>
</Container>
